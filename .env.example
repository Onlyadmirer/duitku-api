# Koneksi PostgreSQL
# Untuk deploy di Vercel + Neon, gunakan connection string "pooled"
# (host mengandung "-pooler") agar kompatibel dengan serverless.
DATABASE_URL=postgresql://user:password@localhost:5432/duitku

# Secret untuk sign & verifikasi JWT access token
# Isi dengan string acak yang panjang, contoh: openssl rand -hex 32
ACCESS_TOKEN_SECRET=ganti-dengan-secret-acak

# development | production
NODE_ENV=development

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173
